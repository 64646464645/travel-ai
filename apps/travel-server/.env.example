# 服务配置
# 非生产环境默认挂载 /api-docs 与 /api-docs.json；生产部署必须显式设置为 production
NODE_ENV=development
PORT=3300
PROVIDER=DEEPSEEK
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_MS=120000
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-flash

# MySQL 短期记忆存储
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=travel_ai
MYSQL_CONNECTION_LIMIT=10
MEMORY_WINDOW_SIZE=10

# RAG 长期记忆（依赖 QWEN_API_KEY，与 LLM 的 PROVIDER 无关）
EMBEDDING_MODEL=qwen3.7-text-embedding
# 可选：指定 embedding 输出维度（qwen3.7-text-embedding 支持 2560/2048/1536/1024/768/512/256，默认 1024）
# EMBEDDING_DIMENSIONS=1024
MEMORY_TOP_K=4
MEMORY_SCORE_THRESHOLD=0.3
VECTOR_INDEX_DIR=data/vectra
# 默认 true。设为 false 时关闭结构化抽取，回退为原文切块写入。
MEMORY_EXTRACTION_ENABLED=true
# 可选。逗号分隔；设置后完全覆盖内置关键词表（喜欢、不喜欢、偏好、预算、计划、去过、不吃、禁忌）。
# MEMORY_EXTRACTION_KEYWORDS=喜欢,预算,计划
# 结构化事实覆盖判定阈值，与 MEMORY_SCORE_THRESHOLD 独立。
MEMORY_COVERAGE_THRESHOLD=0.8

# 登录鉴权（生产环境请使用足够长的随机密钥）
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
